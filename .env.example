# Names only. The real .env lives on the cluster node (mode 600, git-ignored);
# Kubernetes Secrets are created from it by a script, never printed.
# No inline comments after values: sync scripts take the whole rest of the line.

PORT=8080

# Mode: mock | test | live (ADR-0029).
SHOP_MODE=mock

# Printful private tokens, store-level: the live store and the test store (ADR-0029).
PRINTFUL_TOKEN=
PRINTFUL_TOKEN_TEST=

# Stripe restricted keys; the mode selects which one the app gets. The live key only at go-live.
STRIPE_TEST_TOKEN=
STRIPE_LIVE_TOKEN=

# Admin sign-in (Google OAuth, client in the cluster's Google Cloud project).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://shop.klaushofrichter.net/auth/google/callback
ALLOWED_EMAILS=
COOKIE_SECRET=

# Status links in customer e-mails: HMAC secret, random, 32 bytes (ADR-0037). Needed from step 8.
STATUS_TOKEN_SECRET=

# Webhook secrets, created when the endpoints are registered (ADR-0030, docs/design/06 §5).
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_WEBHOOK_SECRET=
PRINTFUL_WEBHOOK_SECRET=
PRINTFUL_WEBHOOK_PUBLIC_KEY=

# Preview gate key for the shop before and right after go-live (ADR-0039).
PREVIEW_KEY=

# Amazon SES (ADR-0015): IAM user limited to SendEmail/SendRawEmail from the orders address.
# create-secrets.sh puts these into the shop-env Secret.
SHOP_SES_AWS_ACCESS_KEY_ID=
SHOP_SES_AWS_SECRET_ACCESS_KEY=

# Litestream backups to S3 (docs/design/11 §3): IAM user limited to the backup bucket.
# create-secrets.sh puts these into the shop-litestream Secret, never into the app's.
SHOP_BACKUP_AWS_ACCESS_KEY_ID=
SHOP_BACKUP_AWS_SECRET_ACCESS_KEY=

# Not here: the expected Printful store per mode, the fail-safe thresholds and the packing-slip
# contact (PACKING_SLIP_EMAIL, PACKING_SLIP_PHONE; SHOP_NAME, PROVIDER_RETRY_WINDOW_HOURS, COMPLETE_AFTER_SHIPPED_DAYS) live in kube-setup's ConfigMap.
