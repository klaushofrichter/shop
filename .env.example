# Names only. The real .env lives on the cluster node (mode 600, git-ignored);
# Kubernetes Secrets are created from it by a script, never printed.
# No inline comments after values: sync scripts take the whole rest of the line.

PORT=8080

# Printful private token, store-level (ADR-0005).
PRINTFUL_TOKEN=

# Stripe restricted keys. STRIPE_MODE selects which one is used; development
# and the first end-to-end runs use test mode. The live key only at go-live.
STRIPE_MODE=test
STRIPE_TEST_TOKEN=
STRIPE_LIVE_TOKEN=

# Admin sign-in (Google OAuth, client in the skylar-technology project).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://shop.klaushofrichter.net/auth/google/callback
ALLOWED_EMAILS=
COOKIE_SECRET=
